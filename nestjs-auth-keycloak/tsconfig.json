{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "baseUrl": "../",
    "rootDir": "../",
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "paths": {
      "@jaltech/nestjs-auth-core": ["nestjs-auth-core/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
