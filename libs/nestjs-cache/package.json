  "license": "MIT",
  "author": "ProfesSkills",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://forge.profeskills.com/jal-group/nestjs-libs.git",
    "directory": "libs/nestjs-cache"
